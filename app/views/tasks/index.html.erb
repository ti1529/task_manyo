<h1><%= t".title" %></h1>

<%= form_with(scope: :search, method: :get, local: true) do |f| %>

  <div class="row">
    <div class="field col-2 d-flex flex-column">
      <%= f.label Task.human_attribute_name(:status) %>
      <%= f.select :status,
            Task.statuses.keys.map {|key|[Task.statuses_i18n[key], key] },
            include_blank: true  
      %>
    </div>

    <div class="field col-4 d-flex flex-column">
      <%= f.label Task.human_attribute_name(:title) %>
      <%= f.search_field :title %>
    </div>

    <div class="field col-4 d-flex flex-column">
      <%= f.label Task.human_attribute_name(:label) %>
      <%= f.select :label,
            current_user.labels.collect { |label| [label.name, label.id]},
            include_blank: true
      %>
    </div>

  </div>

  <div class="action row justify-content-end">
    <%= f.submit "検索", id: "search_task", class: "btn btn-primary col-1" %>
    <div class="col-2"></div>

  </div>

<% end %>

<table class="table my-4">
  <thead>
    <tr>
      <th><%= t("activerecord.attributes.task.title") %></th>
      <th><%= Task.human_attribute_name(:content) %></th>
      <th><%= t("attributes.created_at") %></th>
      <th><%= link_to Task.human_attribute_name(:deadline_on), sort_deadline_on: true, class: "text-primary" %></th>
      <th><%= link_to Task.human_attribute_name(:priority), sort_priority: true, class: "text-primary" %></th>
      <th><%= Task.human_attribute_name(:status) %></th>

      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at %></td>
        <td><%= task.deadline_on %></td>
        <td><%= task.priority_i18n %></td>
        <td><%= task.status_i18n %></td>

        <td><%= link_to t('common.show'), task, class: "show-task btn btn-primary btn-sm" %></td>
        <td><%= link_to t("common.edit"), edit_task_path(task), class: "edit-task btn btn-primary btn-sm" %></td>
        <td><%= link_to t("common.destroy"), task, class: "destroy-task btn btn-danger btn-sm", method: :delete, data: { confirm: t("common.confirm_destroy") } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>
