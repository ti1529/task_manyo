<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:</h2>

      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-group row">
    <%= form.label :title, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-6">
      <%= form.text_field :title, class:"form-control" %>
    </div>
  </div>

  <div class="field form-group row">
    <%= form.label :content, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-6">
      <%= form.text_area :content, class: "form-control" %>
    </div>
  </div>

  <div class="field form-group row" >
    <%= form.label :deadline_on, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-4">
      <%= form.date_field :deadline_on, class: "form-control" %>
    </div>
  </div>

  <div class="field form-group row" >
    <%= form.label :priority, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-4">

      <%= form.select :priority,
        Task.priorities.keys.map {|key| [Task.priorities_i18n[key], key] },
        { include_blank: true },
        { class: "form-control" }
      %>
    </div>
  </div>

  <div class="field form-group row" >
    <%= form.label :status, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-4">
        <%= form.select :status,
          Task.statuses.keys.map {|key| [Task.statuses_i18n[key], key] },
          { include_blank: true },
          { class: "form-control" }
        %>

    </div>
  </div>

  <div class="field form-group row">
    <div class="col-sm-2">
      <%= form.label :label %>
    </div>
    <div class="col-sm-8">
      <div class="form-check">
        <% current_user.labels.each do |label| %>
          <%= form.check_box :label_ids,
            { multiple: true, include_hidden: false },
            label[:id],
            { class: "form-check-input" }
          %>
          <label for=<%="task_label_ids_#{label[:id] }"%> class="form-check-label mr-4"><%= "#{label.name}" %></label>
        <% end %>

      </div>
    </div>
  </div>

  <div class="actions form-group row">
    <div class="col-sm-2 ">
      <%= form.submit id: id, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
