<h1><%= t(".title") %></h1>
<%= form_with(scope: :session, url: sessions_path, local: true) do |f| %>
  <div class="field">
    <%= f.label :email, t(".email") %>
    <%= f.email_field :email %>
  </field>
  <div class="field">
    <%= f.label :password, t(".password") %>
    <%= f.password_field :password %>
  </div>
  <div class="actions">
    <%= f.submit t(".submit"), id: "create-session" %>
  </div>
<% end %>
