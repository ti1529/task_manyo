<h1><%= t(".title") %></h1>
<%= form_with(scope: :session, url: sessions_path, local: true) do |f| %>

  <div class="field form-group row">
    <%= f.label :email, t(".email"), class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <%= f.email_field :email, type: "email", placeholder: "email" %>
    </div>
  </div>

  <div class="field form-group row">
    <%= f.label :password, t(".password"), class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <%= f.password_field :password, type: "password", placeholder: "password" %>
    </div>
  </div>

  <div class="actions form-group row">
    <div class="col-sm-10">
      <%= f.submit t(".submit"), id: "create-session", class: "btn btn-primary" %>
    </div>
  </div>
  
<% end %>
