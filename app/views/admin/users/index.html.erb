<h1><%= t(".title") %></h1>

<%# binding.irb %>

<%# ------エラーメッセージ------ %>
<% if @user.present? && @user.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@user.errors.count, "error") %> prohibited this <%= @user.name %> from being saved:</h2>
    <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
    </ul>
  </div>
<% end %>



<table>
  <thead>
    <tr>
      <th><%= User.human_attribute_name(:name) %></th>
      <th><%= User.human_attribute_name(:email) %></th>
      <th><%= User.human_attribute_name(:admin) %></th>
      <th>タスク数</th>

    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.admin ? t("common.is_admin") : t("common.not_admin") %></td>
        <td><%= user.tasks.size %></td>

        <td><%= link_to t("common.show"), admin_user_path(user.id), class: "show-user" %></td>
        <td><%= link_to t("common.edit"), edit_admin_user_path(user.id), class: "edit-user" %></td>
        <td><%= link_to t("common.destroy"), [:admin, user], class: "destroy-user", method: :delete, data: { confirm: t(".delete_confirm") } %></td>

      </tr>
    <% end %>
  </tbody>
</table>