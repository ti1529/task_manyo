<% if user.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(user.errors.count, "error") %> prohibited this <%= user.name %> from being saved:</h2>
    <ul>
    <% user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
    </ul>
  </div>
<% end %>



<%= form_with(model: [:admin, @user], local: true) do |f| %>

  <div class="field form-group row">
    <%= f.label :name, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <%= f.text_field :name, placeholder: "name" %>
    </div>
  </div>

  <div class="field form-group row">
    <%= f.label :email, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <%= f.email_field :email, type: "email", placeholder: "email" %>
    </div>
  </div>

  <div class="field form-group row">
    <%= f.label :password, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <%= f.password_field :password, type: "password", placeholder: "password" %>
    </div>
  </div>

  <div class="field form-group row">
    <%= f.label :password_confirmation, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <%= f.password_field :password_confirmation, type: "password", placeholder: "password" %>
    </div>
  </div>
  
  <div class="field form-group row">
    <%= f.label :admin, class: "col-sm-2 col-form-label" %>
    <div class="col-sm-10">
      <div class="form-check">
        <%= f.check_box :admin, {}, "true", "false" %>
      </div>
    </div>
  </div>

  <div class="actions form-group row">
    <div class="col-sm-10">
      <%= f.submit id: id, class: "btn btn-primary" %>
    </div>
  </div>

<% end %>
