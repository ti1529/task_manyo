<h1><%= t(".title") %></h1>

<table>
  <thead>
    <tr>
      <th><%= Label.human_attribute_name(:name) %></th>
      <th><%= t("common.tasks_count")%></th>

      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.size %></td>

        <td><%= link_to t("common.edit"), edit_label_path(label.id), class: "edit-label" %></td>
        <td><%= link_to t("common.destroy"), label, class: "destroy-label", method: :delete, data: { confirm: t(".destroy_confirm") } %></td>

      </tr>
    <% end %>
  </tbody>
</table>
