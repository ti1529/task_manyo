
<% if label.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(label.errors.count, "label") %> prohibited this label from being saved:</h2>

    <ul>
      <% label.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>


<%= form_with(model: label, local: true) do |f| %>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>