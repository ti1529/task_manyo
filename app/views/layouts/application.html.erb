<!DOCTYPE html>
<html>
  <head>
    <title>CdpWebManyoTask</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <%# ----グローバルナビゲーション----- %>
    <nav>
      <ul>
        <% if logged_in? %>
          <% if current_user.admin? %>
            <li><%= link_to "ユーザ一覧", admin_users_path, id: "users-index" %></li>
            <li><%= link_to "ユーザを登録する", new_admin_user_path, id: "add-user" %></li>
          <% end %>

          <li><%= link_to t("tasks.link.index"), tasks_path, id: "tasks-index" %></li>
          <li><%= link_to t("tasks.link.new"), new_task_path, id: "new-task" %></li>

          <li><%= link_to t("labels.link.index"), labels_path, id: "labels-index" %></li>
          <li><%= link_to t("labels.link.new"), new_label_path, id: "labels-index" %></li>

          <li><%= link_to t("users.link.show"), user_path(current_user.id), id: "account-setting" %></li>
          <li><%= link_to t("sessions.link.destroy"), session_path(current_user.id), method: :delete, id: "sign-out" %></li>

        <% else %>
          <li><%= link_to t("users.link.new"), new_user_path, id: "sign-up" %></li>
          <li><%= link_to t("sessions.link.new"), new_session_path, id: "sign-in" %></li>
        
        <% end %>
      </ul>
    </nav>

    <%# ---フラッシュメッセージ---- %>
    <% flash.each do |key, value| %>
      <%= content_tag(:p, value, id: "#{key}") %>
    <% end %>

    <%= yield %>
  </body>
</html>
