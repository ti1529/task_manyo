<!DOCTYPE html>
<html>
  <head>
    <title>CdpWebManyoTask</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <%# ----グローバルナビゲーション----- %>
    <nav>
      <ul>
        <li><%= link_to t("common.tasks_index"), tasks_path, id: "tasks-index" %></li>
        <li><%= link_to t("common.new_task"), new_task_path, id: "new-task" %></li>
      </ul>
    </nav>

    <%# ---フラッシュメッセージ---- %>
    <% flash.each do |key, value| %>
      <%= content_tag(:div, value, class: "#{key}") %>
    <% end %>

    <%# -----------ログインリンク--------- %>
    <% if logged_in? %>
      <%= link_to "ユーザ詳細", user_path(current_user.id)  %>
      <%= link_to "logout", session_path(current_user.id), method: :delete %>
    <% else %>
      <%= link_to "Sign up: ユーザ登録", new_user_path %>
      <%= link_to "login", new_session_path %>
    <% end %>

    <%= yield %>
  </body>
</html>
